<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @page {
            size: {{ anchoPt }}pt {{ altoPt }}pt;
            margin: 0;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Times New Roman", Times, serif;
            font-size: 10pt;
            color: #000;
        }
        .tarjeta {
            width: {{ (215 * escalaX)|round(1) }}pt;
            /* dompdf no respeta box-sizing:border-box para height+padding;
               326pt de contenido + 32pt de padding = 358pt total (tamaño de referencia 216x360) */
            height: {{ (326 * escalaY)|round(1) }}pt;
            padding: {{ (16 * escalaY)|round(1) }}pt {{ (18 * escalaX)|round(1) }}pt;
            position: relative;
        }
        .salto {
            page-break-after: always;
        }
        .fila-superior {
            position: relative;
            height: {{ (11 * escalaY)|round(1) }}pt;
            font-size: 9pt;
        }
        .fila-superior .izquierda {
            position: absolute;
            left: 0;
            top: 0;
            width: {{ (90 * escalaX)|round(1) }}pt;
            text-align: left;
        }
        .fila-superior .derecha {
            position: absolute;
            left: {{ (90 * escalaX)|round(1) }}pt;
            top: 0;
            width: {{ (90 * escalaX)|round(1) }}pt;
            text-align: right;
        }
        .autor {
            font-weight: bold;
            margin-top: {{ autorMarginTopPt }}pt;
            width: {{ anchoAutorPt }}pt;
            overflow-wrap: break-word;
        }
        .titulo {
            margin-top: {{ tituloMarginTopPt }}pt;
            width: {{ (179 * escalaX)|round(1) }}pt;
            overflow-wrap: break-word;
        }
        .sistema {
            position: absolute;
            top: {{ (338.5 * escalaY)|round(1) }}pt;
            left: {{ (18 * escalaX)|round(1) }}pt;
            width: {{ (180 * escalaX)|round(1) }}pt;
            font-size: 8pt;
            text-align: right;
        }
    </style>
</head>
<body>
{% for tarjeta in tarjetas %}
    <div class="tarjeta{{ not loop.last ? ' salto' : '' }}">
        <div class="fila-superior">
            <div class="izquierda">{{ tarjeta.clasificacion }}</div>
            <div class="derecha">{{ remision.prefijoAdquisicion }}-{{ tarjeta.adquision }}</div>
        </div>
        <div class="autor" style="font-size: {{ autorFontSizes[tarjeta.id] }}pt;">{{ tarjeta.autor }}</div>
        <div class="titulo">{{ tarjeta.titulo }}</div>
        <div class="sistema">{{ tarjeta.sistema }}</div>
    </div>
{% endfor %}
</body>
</html>
